# Wumpo environment template.
#
# The project intentionally needs no secrets: it builds, tests and runs fully
# offline, and CI requires no credentials. This file exists so that any future
# variable has an obvious, safe home.
#
# Copy to .env for local use. NEVER commit .env — see SECURITY.md.

# Overrides the directory the emulator writes saves, screenshots and replays to.
# Defaults to %LOCALAPPDATA%\Wumpo on Windows.
WUMPO_DATA_DIR=replace_me
